[Unit]
Description=Register Science Tokyo LMS Discord slash commands
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=lms-bot
Group=lms-bot
WorkingDirectory=/opt/science-tokyo-lms-discord-bot
Environment=NODE_ENV=production
EnvironmentFile=/etc/lms-bot.env
ExecStart=/usr/bin/node dist/scripts/register-commands.js
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
