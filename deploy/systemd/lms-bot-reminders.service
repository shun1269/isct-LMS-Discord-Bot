[Unit]
Description=Science Tokyo LMS deadline reminder check
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=lms-bot
Group=lms-bot
WorkingDirectory=/opt/science-tokyo-lms-discord-bot
Environment=NODE_ENV=production
EnvironmentFile=/etc/lms-bot.env
ExecStart=/usr/bin/node dist/scripts/run-reminders.js
TimeoutStartSec=12min
StateDirectory=lms-bot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
