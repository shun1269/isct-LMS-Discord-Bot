{
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "sourceMap": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "module": "NodeNext",
    "types": [
      "node",
      "vitest/globals"
    ],
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ]
}
