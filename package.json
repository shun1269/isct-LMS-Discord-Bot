{
  "name": "science-tokyo-lms-discord-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted Science Tokyo LMS sync API and Discord reminders for Ubuntu",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "reminders:run": "node --env-file-if-exists=.env dist/scripts/run-reminders.js",
    "register-commands": "node --env-file-if-exists=.env dist/scripts/register-commands.js",
    "db:import": "node --env-file-if-exists=.env dist/scripts/import-d1.js",
    "db:backup": "node --env-file-if-exists=.env dist/scripts/backup-database.js",
    "env:migrate": "node dist/scripts/prepare-env.js"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0",
    "zod": "^4.4.3",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
